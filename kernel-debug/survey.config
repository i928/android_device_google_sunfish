# SUNFISH_KERNEL_DEBUG survey mode (default; SUNFISH_KDEBUG_SURVEY=0 keeps the
# variant's panics): report and keep running, so one boot collects every report
# and a flashed daily phone does not boot-loop on the first WARN.
# CONFIG_PANIC_ON_WARN_DEFAULT_ENABLE is not set
# CONFIG_DEBUG_SPINLOCK_PANIC_ON_BUG is not set
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set
# CONFIG_BOOTPARAM_HARDLOCKUP_PANIC is not set
# CONFIG_SLUB_DEBUG_PANIC_ON is not set
# CONFIG_PANIC_ON_RT_THROTTLING is not set
# CONFIG_PANIC_ON_DATA_CORRUPTION is not set
# CONFIG_KASAN_PANIC_ON_WARN is not set
# DEBUG_KOBJECT_RELEASE delays every kobject release; drivers that embed a
# kobject in devm memory (dwc3's usb_gadget) then fire a freed timer at boot.
# CONFIG_DEBUG_KOBJECT_RELEASE is not set
# Report freed-while-active timers/works/rcu heads (and cancel them).
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
